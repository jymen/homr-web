{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/vitest"],
  // Golden data is generated by tools/dump-golden.py, never edited by hand.
  "files": { "includes": ["!!test/golden"] },
  "linter": {
    "rules": {
      "suspicious": {
        // No console in the library: it runs inside a Worker on a musician's machine.
        "noConsole": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["tools/**", "bench/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" },
          // gen-manifest.mjs opens the eight models one at a time on purpose:
          // eight concurrent sessions would hold every model's wasm arena at once.
          "performance": { "noAwaitInLoops": "off" }
        }
      }
    },
    {
      // dtype.ts is the one module in src/ that is bit-level arithmetic, which
      // is why it is its own file. Bitwise operators are its subject, and a
      // half's fields are a 16-bit pattern: 0x7c00 is one exponent mask, where
      // 0x7c_00 would group it at the byte boundary instead of the 5/10 split.
      "includes": ["src/models/dtype.ts", "test/dtype.test.ts"],
      "linter": {
        "rules": {
          "style": { "useNumericSeparators": "off" },
          "suspicious": { "noBitwiseOperators": "off" }
        }
      }
    },
    {
      // resize.ts reproduces PIL's fixed-point resample, where the closing
      // `>> 22` is the arithmetic itself: a division by 2 ** 22 rounds where
      // the shift truncates, which is a different function and a different
      // byte. The accumulator's bias is written as a shift for the same reason.
      "includes": ["src/segmentation/resize.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noBitwiseOperators": "off" }
        }
      }
    },
    {
      // segmentPage awaits one session.run per batch inside the tile loop, and
      // that is the design rather than an oversight: a page's tiles share one
      // session and one wasm arena, and the batch is already the parallelism,
      // bounded by the model's own pinned batch dimension. Running a page's
      // seven batches together would hold 207 MB of input and logit tensors in
      // that one arena instead of 30.
      "includes": ["src/segmentation/segment.ts"],
      "linter": {
        "rules": {
          "performance": { "noAwaitInLoops": "off" }
        }
      }
    },
    {
      // opencv.js's module object arrives thenable, and its shim calls back with
      // the module itself, so resolving a promise with it recurses without end.
      // The loader clears the property, and the test drives a deliberate
      // thenable to prove it stays cleared. The rule guards against making a
      // thenable by accident; this feature's subject is unmaking one.
      "includes": ["src/cv/opencv.ts", "test/opencv.test.ts"],
      "linter": {
        "rules": {
          "suspicious": { "noThenProperty": "off" }
        }
      }
    },
    {
      // @techstark/opencv-js has no default export, so a namespace import is the
      // only static form, and static is the whole point here: an `import()`
      // resolves its own promise with the namespace. The rule is about
      // tree-shaking, which cannot reach inside a 10.9 MB emscripten bundle.
      "includes": ["src/cv/default-source.ts"],
      "linter": {
        "rules": {
          "performance": { "noNamespaceImport": "off" }
        }
      }
    },
    {
      // src/geometry/ is the detection logic with no opencv.js in it, so that an
      // ordering or tie rule can be tested without loading a 10.9 MB wasm
      // module. What it needs from OpenCV it is handed as a BoxOps.
      "includes": ["src/geometry/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/cv/**"],
                    "message": "src/geometry/ takes a BoxOps (src/geometry/box-ops.ts), never src/cv/."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      // A library needs one entry point that re-exports its modules.
      "includes": ["src/index.ts"],
      "linter": {
        "rules": {
          "performance": { "noBarrelFile": "off", "noReExportAll": "off" }
        }
      }
    }
  ]
}
