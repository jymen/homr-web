{
  "name": "homr-web",
  "version": "0.1.0",
  "description": "Browser port of homr, the optical music recognition engine: sheet music image in, MusicXML out, no server.",
  "homepage": "https://github.com/jymen/homr-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jymen/homr-web.git"
  },
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "scripts": {
    "bench": "npm run build && node bench/serve.mjs",
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "format": "biome check --write .",
    "golden": ".venv/bin/python tools/dump-golden.py",
    "lint": "biome check .",
    "ocr": ".venv/bin/python tools/dump-ocr.py",
    "test": "vitest run",
    "vectors": ".venv/bin/python tools/dump-vectors.py"
  },
  "dependencies": {
    "@techstark/opencv-js": "4.12.0-release.1",
    "@webgpu/types": "^0.1.64",
    "delaunator": "5.1.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^22.0.0",
    "@types/pngjs": "^6.0.5",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "ultracite": "^7.12.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  }
}
